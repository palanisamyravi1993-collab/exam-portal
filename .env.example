# Exam Portal - Environment Configuration Template

# Secret key for token signing (HMAC-SHA256). Change to a long random secret in production!
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-minimum

# Database connection URL:
# - SQLite (default for development): sqlite:///./exam.db
# - PostgreSQL (production / Supabase / Neon / Cloudflare Hyperdrive):
#   postgresql://postgres:password@localhost:5432/examdb
DATABASE_URL=sqlite:///./exam.db

# Public HTTPS URL of the backend API (needed for Safe Exam Browser key hashing)
PUBLIC_URL=http://localhost:8000

# Backend Rate Limiting: Max requests per hour per IP/token (User requirement: 100 req/hour)
RATE_LIMIT_PER_HOUR=100

# Allowed CORS origins (comma-separated, or * for all)
# Example: https://exam-portal.vercel.app,http://localhost:3000,http://localhost:8000
CORS_ORIGINS=*

# Server port
PORT=8000
